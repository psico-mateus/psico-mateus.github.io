        "patient_map_draft_field_type_check": {
          "name": "patient_map_draft_field_type_check",
          "value": "\"patient_map_draft_fields\".\"field_type\" IN ('state', 'answer', 'position', 'synthesis')"
        },
        "patient_map_draft_content_version_check": {
          "name": "patient_map_draft_content_version_check",
          "value": "length(\"patient_map_draft_fields\".\"content_version\") BETWEEN 1 AND 80"
        },
        "patient_map_draft_field_id_check": {
          "name": "patient_map_draft_field_id_check",
          "value": "length(\"patient_map_draft_fields\".\"field_id\") BETWEEN 1 AND 80"
        },
        "patient_map_draft_generation_check": {
          "name": "patient_map_draft_generation_check",
          "value": "\"patient_map_draft_fields\".\"generation\" >= 1"
        },
        "patient_map_draft_value_check": {
          "name": "patient_map_draft_value_check",
          "value": "\"patient_map_draft_fields\".\"value\" IS NULL OR length(\"patient_map_draft_fields\".\"value\") <= 4096"
        },
        "patient_map_draft_revision_check": {
          "name": "patient_map_draft_revision_check",
          "value": "\"patient_map_draft_fields\".\"revision\" >= 0"
        },
        "patient_map_draft_request_id_check": {
          "name": "patient_map_draft_request_id_check",
          "value": "(\"patient_map_draft_fields\".\"field_type\" = 'state' AND (\"patient_map_draft_fields\".\"request_id\" = '' OR length(\"patient_map_draft_fields\".\"request_id\") BETWEEN 16 AND 80))\n        OR (\"patient_map_draft_fields\".\"field_type\" <> 'state' AND length(\"patient_map_draft_fields\".\"request_id\") BETWEEN 16 AND 80)"
        },
        "patient_map_draft_state_shape_check": {
          "name": "patient_map_draft_state_shape_check",
          "value": "(\"patient_map_draft_fields\".\"field_type\" = 'state' AND \"patient_map_draft_fields\".\"field_id\" = '__state__' AND \"patient_map_draft_fields\".\"value\" IS NULL)\n        OR (\"patient_map_draft_fields\".\"field_type\" <> 'state' AND \"patient_map_draft_fields\".\"field_id\" <> '__state__')"
        }
      }
    },
