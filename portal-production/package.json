{
  "name": "area-do-paciente",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "build:worker": "node scripts/run-vinext.mjs CLOUDFLARE_PUBLIC_DEPLOY=1 build",
    "deploy:worker": "pnpm build:worker && wrangler deploy",
    "start": "node scripts/run-vinext.mjs start",
    "typecheck": "node -e \"require('node:fs').mkdirSync('.wrangler/types',{recursive:true})\" && wrangler types .wrangler/types/worker-runtime.d.ts --include-env=false --include-runtime=true && tsc -p tsconfig.app.json --pretty false && tsc -p tsconfig.worker.json --pretty false",
    "test": "pnpm typecheck && pnpm build && node --test tests/*.test.mjs",
    "test:integration": "node tests/portal.integration.mjs",
    "test:integration:isolated": "node scripts/run-isolated-integration.mjs",
    "test:mfa-rotation-local": "node --test tests/professional-mfa-rotation.test.mjs",
    "test:restore-local": "node scripts/rehearse-local-restore.mjs",
    "test:smoke-public": "node scripts/smoke-public.mjs",
    "test:visual": "node tests/manual-visual-review.mjs",
    "test:visual:professional": "node tests/manual-professional-visual-review.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "axe-core": "4.11.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.1.6",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
